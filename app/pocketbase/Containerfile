# Cetana Labs — PocketBase container image (RFC-LAB-000-007)
# Podman-first (OCI); also builds with Docker. Used for staging/GCP parity and the
# forward datastore path. Local dev normally runs the bare binary (`make pb-serve`).
#
# Build:  podman build -t cetana-pocketbase -f app/pocketbase/Containerfile app/pocketbase
#         (or: docker build ... — identical, OCI image)
# Run:    podman run -p 8090:8090 -v cetana_pb_data:/pb/pb_data cetana-pocketbase
#
# PocketBase is a single static binary; a minimal base keeps the image tiny.

# Un-pinned to 0.40.x (BK-018 fixed). The earlier 0.28.4 pin was a workaround for a
# 0.40 sign-in failure on Railway: the SDK's all-in-one OAuth2 *popup* received its
# callback over the realtime SSE channel (`/api/realtime`), which Railway's proxy does
# not preserve → `400 Invalid realtime client`. The fix (RFC-LAB-000-011 §4.5) switched
# the frontend to the redirect-based `authWithOAuth2Code` flow, which never touches
# `/api/realtime` — so 0.40+ is safe on Railway. Live prod version cutover is BK-019.
ARG PB_VERSION=0.40.4

FROM docker.io/library/alpine:3.20

ARG PB_VERSION
ARG TARGETARCH=amd64

RUN apk add --no-cache ca-certificates unzip wget

WORKDIR /pb

# Fetch the PocketBase release binary for the target arch.
RUN wget -q "https://github.com/pocketbase/pocketbase/releases/download/v${PB_VERSION}/pocketbase_${PB_VERSION}_linux_${TARGETARCH}.zip" -O /tmp/pb.zip \
    && unzip /tmp/pb.zip -d /pb \
    && rm /tmp/pb.zip \
    && chmod +x /pb/pocketbase

# Collections schema is imported at first boot / via the admin UI or pb_import.py.
COPY pb_schema.json /pb/pb_schema.json

# JS hooks (M3–M4): oauth_github_handle.pb.js populates `github_handle` on GitHub OAuth
# sign-in — REQUIRED for the owner-write path (the owner updateRule matches on handle).
# Without this in the image, a deployed sign-in leaves github_handle empty and owner
# edits are rule-denied (404). PocketBase auto-loads pb_hooks/ next to the binary.
COPY pb_hooks/ /pb/pb_hooks/

EXPOSE 8090

# NOTE: no `VOLUME` instruction here — Railway rejects Dockerfile VOLUME declarations
# ("VOLUME ... is not supported, use Railway Volumes"). Persistence is attached at RUN
# time instead, which is portable across all our targets:
#   - Railway:      attach a Railway Volume mounted at /pb/pb_data (dashboard/config).
#   - Podman/Docker: run with `-v cetana_pb_data:/pb/pb_data` (see the Run comment above).
# The data path (/pb/pb_data) is unchanged; only the declaration mechanism differs.

# Bind to all interfaces so the container is reachable via the mapped port.
ENTRYPOINT ["/pb/pocketbase", "serve", "--http=0.0.0.0:8090"]
