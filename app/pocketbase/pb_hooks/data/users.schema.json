{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agni-eialarasu.github.io/cetana-labs/data/users.schema.json",
  "title": "Cetana Labs User Master",
  "description": "User master records. Maps to a future PocketBase 'users' collection (RFC-LAB-000-002).",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "name", "role", "active"],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^usr-[a-z0-9-]+$",
        "description": "Stable slug identity, e.g. 'usr-eialarasu'."
      },
      "name": { "type": "string", "minLength": 1 },
      "email": { "type": ["string", "null"], "format": "email" },
      "github_handle": { "type": ["string", "null"] },
      "role": {
        "type": "string",
        "enum": ["owner", "lead", "contributor", "stakeholder", "reviewer"]
      },
      "org": { "type": ["string", "null"] },
      "active": { "type": "boolean" }
    }
  }
}
