# Cetana Labs — environment configuration template (RFC-LAB-000-007)
# Copy to .env and fill in. .env is gitignored; never commit real secrets.

# --- PocketBase (local backend, BK-008) ---
PB_URL=http://127.0.0.1:8090
PB_ADMIN_EMAIL=admin@cetana.local
PB_ADMIN_PASSWORD=change-me-locally

# Sleek UI data source (BK-011 / M1): the SvelteKit app reads the live portfolio from
# PocketBase via a VITE_-prefixed var (client-exposed static SPA). See app/web/.env.example.
# VITE_PB_URL defaults to http://127.0.0.1:8090; VITE_PB_SOURCE = pocketbase|snapshot|auto.
VITE_PB_URL=http://127.0.0.1:8090

# --- Sleek UI (SvelteKit) ---
# Base path when deploying under a subpath (GitHub Pages project site).
BASE_PATH=

# --- GitHub OAuth2 sign-in (BK-011 / M2, RFC-LAB-000-006) ---
# NOT read from this file. Configured in the PocketBase admin, per-collection (v0.40+):
#   Collections → `users` → Options → OAuth2 → enable → add GitHub (client id + secret).
# The dev GitHub OAuth app's callback = the PB OAuth2 redirect. Secrets stay local /
# uncommitted (RFC-LAB-000-011 §4.3). Setup steps: docs/guides/developer-guide.md.
# These keys are documentation only — the values live in PB, not in env:
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=

# --- Staging (planned: GCP primary, optional Vercel — RFC-LAB-000-007) ---
# STAGING_BACKEND_URL=
# STAGING_FRONTEND_URL=

# --- GitHub automation (used by scripts/ping_leads.py etc.) ---
# GITHUB_TOKEN=
