*$py.class

# Node
node_modules/

# =============================================================================
# Build Output & Logs
# =============================================================================
dist/
build/
*.log

# =============================================================================
# Environment & Secrets (RFC-LAB-000-007) — never commit real secrets
# =============================================================================
.env
.env.local
.env.staging
.env.*.local
.venv/
# ...but keep the committed *.example templates tracked
!.env.example
!.env.staging.example

# =============================================================================
# PocketBase (BK-008) — runtime data + downloaded binary (never committed)
# =============================================================================
app/pocketbase/pocketbase
app/pocketbase/pb_data/
app/pocketbase/pb_migrations/
# Defensive: a stray pb_data/ anywhere (e.g. a raw `pocketbase serve` from the repo root
# before --dir was pinned) — local SQLite runtime data, never tracked.
pb_data/

# =============================================================================
# Deployment
# =============================================================================
.vercel

# =============================================================================
# Governance Receipts
# =============================================================================
.gemini/governance/

# =============================================================================
# Developer-Local (never commit)
# =============================================================================
_my_kiro
_my_works

# KiroCrew CLI runtime settings — machine-local tool state (NOT project config).
# The rest of .kiro/ (skills, specs, steering) IS committed; only settings/ is local.
.kiro/settings/

