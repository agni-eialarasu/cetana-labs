# Cetana Labs — STAGING environment template (RFC-LAB-000-011 / BK-017).
# Copy to `.env.staging` (gitignored — never commit real values) and fill in.
# Used to point the seed/health scripts at a deployed staging backend without
# hand-typing the URL each time, e.g.:
#   set -a; source .env.staging; set +a
#   python3 scripts/pb_provision.py --apply && python3 scripts/pb_import.py --apply
#
# NOTE: provisioning the Railway service/volume, the Vercel project, and the GitHub
# OAuth app is still done in the consoles (see docs/guides/developer-guide.md §9);
# these vars only drive the repeatable seed/verify steps + document the wiring.

# --- Staging backend (PocketBase on Railway) ---
PB_URL=https://<your-staging-app>.up.railway.app
PB_ADMIN_EMAIL=admin@cetana.local
PB_ADMIN_PASSWORD=change-me-in-railway   # set the REAL value in Railway service vars, not here

# --- Staging frontend (SvelteKit on Vercel) ---
# Set in the Vercel project (Preview/Production env), pointing at the Railway URL above:
VITE_PB_URL=https://<your-staging-app>.up.railway.app
# VERCEL_STAGING_URL=https://<your-preview>.vercel.app   # informational

# --- GitHub OAuth (configured in the staging PocketBase admin, NOT here) ---
# Callback URL on the GitHub OAuth app → <PB_URL>/api/oauth2-redirect
# Client id/secret live in the Railway PB admin (users collection → OAuth2 → GitHub).
